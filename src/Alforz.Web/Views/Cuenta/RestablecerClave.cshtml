@model RestablecerClaveViewModel
@{
    ViewData["Title"] = "Clave nueva";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="alf-card p-4">
            <h1 class="h3 mb-1"><i class="bi bi-shield-lock me-2"></i>Crear clave nueva</h1>
            <p class="text-body-secondary mb-4">Escribe el código que te llegó por correo y tu clave nueva.</p>
            <form asp-action="RestablecerClave" method="post">
                <div asp-validation-summary="ModelOnly" class="mb-3"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Correo" class="form-control" autocomplete="email" placeholder="correo" />
                    <label asp-for="Correo"></label>
                    <span asp-validation-for="Correo"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Codigo" class="form-control" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="000000" autofocus />
                    <label asp-for="Codigo"></label>
                    <span asp-validation-for="Codigo"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="NuevaClave" class="form-control" autocomplete="new-password" placeholder="clave" />
                    <label asp-for="NuevaClave"></label>
                    <span asp-validation-for="NuevaClave"></span>
                    <div class="form-text">Mínimo 8 caracteres, con al menos una letra y un número.</div>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="ConfirmarClave" class="form-control" autocomplete="new-password" placeholder="clave" />
                    <label asp-for="ConfirmarClave"></label>
                    <span asp-validation-for="ConfirmarClave"></span>
                </div>
                <button type="submit" class="btn btn-alf-primario w-100">Guardar clave</button>
            </form>
            <p class="text-center mt-3 mb-0"><a asp-action="OlvideClave">Pedir otro código</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
