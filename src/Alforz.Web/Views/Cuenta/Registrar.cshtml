@model RegistrarViewModel
@{
    ViewData["Title"] = "Registrarse";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="alf-card p-4">
            <h1 class="h3 mb-1"><i class="bi bi-person-plus me-2"></i>Crear cuenta</h1>
            <p class="text-body-secondary mb-4">Las cuentas nuevas entran como <span class="badge rounded-pill badge-rol badge-rol-visita">Visita</span>.</p>
            <form asp-action="Registrar" method="post">
                <div asp-validation-summary="ModelOnly" class="mb-3"></div>
                <div class="form-floating mb-3">
                    <input asp-for="NombreUsuario" class="form-control" autocomplete="username" placeholder="usuario" autofocus />
                    <label asp-for="NombreUsuario"></label>
                    <span asp-validation-for="NombreUsuario"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Correo" class="form-control" autocomplete="email" placeholder="correo" />
                    <label asp-for="Correo"></label>
                    <span asp-validation-for="Correo"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Clave" class="form-control" autocomplete="new-password" placeholder="clave" />
                    <label asp-for="Clave"></label>
                    <span asp-validation-for="Clave"></span>
                    <div class="form-text">Mínimo 8 caracteres, con al menos una letra y un número.</div>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="ConfirmarClave" class="form-control" autocomplete="new-password" placeholder="clave" />
                    <label asp-for="ConfirmarClave"></label>
                    <span asp-validation-for="ConfirmarClave"></span>
                </div>
                <button type="submit" class="btn btn-alf-primario w-100">Crear cuenta</button>
            </form>
            <p class="text-center mt-3 mb-0">¿Ya tienes cuenta? <a asp-action="Ingresar">Ingresa</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
