@model IngresarViewModel
@{
    ViewData["Title"] = "Ingresar";
}

<div class="row g-4 justify-content-center align-items-stretch">
    @* En celular primero el formulario y debajo la presentación; en escritorio, lado a lado. *@
    <div class="col-lg-7 order-2 order-lg-1">
        <partial name="_OverviewAlforz" />
    </div>
    <div class="col-md-8 col-lg-5 order-1 order-lg-2 d-flex flex-column justify-content-center">
        <div class="alf-card p-4">
            <h1 class="h3 mb-1"><i class="bi bi-box-arrow-in-right me-2"></i>Ingresar</h1>
            <p class="text-body-secondary mb-4">
                Bienvenido a Alforz Robotics.
                <a href="#overview" class="d-lg-none">Conoce la compañía <i class="bi bi-arrow-down-short"></i></a>
            </p>
            <form asp-action="Ingresar" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="mb-3"></div>
                <div class="form-floating mb-3">
                    <input asp-for="UsuarioOCorreo" class="form-control" autocomplete="username" placeholder="usuario" autofocus />
                    <label asp-for="UsuarioOCorreo"></label>
                    <span asp-validation-for="UsuarioOCorreo"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Clave" class="form-control" autocomplete="current-password" placeholder="clave" />
                    <label asp-for="Clave"></label>
                    <span asp-validation-for="Clave"></span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input asp-for="Recordarme" class="form-check-input" />
                        <label asp-for="Recordarme" class="form-check-label"></label>
                    </div>
                    <a asp-action="OlvideClave">¿Olvidaste tu clave?</a>
                </div>
                <button type="submit" class="btn btn-alf-primario w-100">Ingresar</button>
            </form>
            <p class="text-center mt-3 mb-0">¿No tienes cuenta? <a asp-action="Registrar">Regístrate</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
