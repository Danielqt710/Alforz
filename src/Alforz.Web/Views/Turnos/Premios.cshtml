@using Alforz.Web.Services.Interfaces
@model IReadOnlyList<PremioUsuario>
@{
    ViewData["Title"] = "Premios";
    var porEntregar = Model.Sum(p => p.Progreso.PorRetirar);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-gift me-2"></i>Premios</h1>
    <a asp-action="Panel" class="btn btn-sm btn-alf-secundario"><i class="bi bi-arrow-left me-1"></i>Volver a turnos</a>
</div>

<p class="text-body-secondary">
    Avance de cada usuario en el camino de premios (un premio cada @(Model.FirstOrDefault()?.Progreso.Meta ?? 12) turnos asistidos).
    @if (porEntregar > 0)
    {
        <strong class="text-body">Tienes @porEntregar @(porEntregar == 1 ? "premio" : "premios") por entregar.</strong>
    }
</p>

@if (Model.Count == 0)
{
    <div class="alf-card p-4 text-center text-body-secondary">Todavía nadie tiene turnos marcados como asistidos.</div>
}
else
{
    <div class="alf-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Camino actual</th>
                        <th class="text-center">Asistidos</th>
                        <th class="text-center">Premios</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (usuario, p) in Model.Select(x => (x.Usuario, x.Progreso)))
                    {
                        <tr class="@(p.PorRetirar > 0 ? "alf-fila-premio" : "")">
                            <td>
                                <div class="fw-semibold">@usuario.NombreUsuario</div>
                                <div class="small text-body-secondary">@usuario.Correo</div>
                            </td>
                            <td style="min-width: 160px">
                                <div class="progress alf-progreso-premio" role="progressbar" aria-label="Camino de @usuario.NombreUsuario"
                                     aria-valuenow="@p.Llenos" aria-valuemin="0" aria-valuemax="@p.Meta">
                                    <div class="progress-bar" style="width: @(p.Llenos * 100 / p.Meta)%"></div>
                                </div>
                                <div class="small mt-1">@p.Llenos de @p.Meta @(p.Completo ? "🎉" : "")</div>
                            </td>
                            <td class="text-center">@p.Asistidos</td>
                            <td class="text-center small">
                                <div>@p.PremiosGanados ganados</div>
                                <div class="text-body-secondary">@usuario.PremiosEntregados entregados</div>
                            </td>
                            <td class="text-end">
                                @if (p.PorRetirar > 0)
                                {
                                    <form asp-action="EntregarPremio" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Marcar un premio como entregado?');">
                                        <input type="hidden" name="usuarioId" value="@usuario.Id" />
                                        <button type="submit" class="btn btn-sm btn-alf-primario">
                                            <i class="bi bi-gift me-1"></i>Entregar@(p.PorRetirar > 1 ? $" (quedan {p.PorRetirar})" : "")
                                        </button>
                                    </form>
                                }
                                else if (p.PremiosGanados > 0)
                                {
                                    <span class="small text-body-secondary"><i class="bi bi-check2-all me-1"></i>Al día</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
