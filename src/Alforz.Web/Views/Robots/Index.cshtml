@using Alforz.Web.Helpers
@model RobotsViewModel
@{
    ViewData["Title"] = "Robots";
}

<h1 class="h3 mb-3"><i class="bi bi-robot me-2"></i>Robots</h1>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="alf-card p-0 overflow-hidden">
            @if (Model.Robots.Count == 0)
            {
                <p class="p-4 mb-0 text-body-secondary text-center">Todavía no hay robots. Agrega el primero.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Robot</th>
                                <th class="text-end">Precio</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Robots)
                            {
                                <tr class="@(r.Activo ? "" : "opacity-50")">
                                    <td>
                                        <div class="fw-semibold">@r.Nombre</div>
                                        @if (!string.IsNullOrWhiteSpace(r.Descripcion))
                                        {
                                            <div class="small text-body-secondary">@r.Descripcion</div>
                                        }
                                        @if (!r.Activo)
                                        {
                                            <span class="badge rounded-pill alf-estado-turno alf-estado-cancelado">Oculto</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap fw-bold">@FormatoPrecio.Dolares(r.Precio)</td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="Editar" asp-route-id="@r.Id" class="btn btn-sm btn-alf-primario" title="Editar"><i class="bi bi-pencil"></i><span class="d-none d-md-inline ms-1">Editar</span></a>
                                            <form asp-action="CambiarEstado" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@r.Id" />
                                                <button type="submit" class="btn btn-sm btn-alf-secundario" title="@(r.Activo ? "Ocultar" : "Mostrar")">
                                                    <i class="bi @(r.Activo ? "bi-eye-slash" : "bi-eye")"></i><span class="d-none d-md-inline ms-1">@(r.Activo ? "Ocultar" : "Mostrar")</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <p class="form-text mt-2">Los robots ocultos no aparecen al agendar. Cambiar un precio no afecta los turnos ya agendados.</p>
    </div>

    <div class="col-lg-5">
        <div class="alf-card p-4">
            <h2 class="h5 mb-3"><i class="bi bi-plus-circle me-2"></i>Agregar robot</h2>
            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="mb-3"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Nuevo.Nombre" class="form-control" placeholder="nombre" />
                    <label asp-for="Nuevo.Nombre"></label>
                    <span asp-validation-for="Nuevo.Nombre"></span>
                </div>
                <div class="form-floating mb-3">
                    <textarea asp-for="Nuevo.Descripcion" class="form-control" placeholder="descripción" style="height: 5rem"></textarea>
                    <label asp-for="Nuevo.Descripcion"></label>
                    <span asp-validation-for="Nuevo.Descripcion"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Nuevo.Precio" type="number" min="0.01" step="0.01" inputmode="decimal" class="form-control" placeholder="precio" />
                    <label asp-for="Nuevo.Precio"></label>
                    <span asp-validation-for="Nuevo.Precio"></span>
                </div>
                <button type="submit" class="btn btn-alf-primario w-100"><i class="bi bi-plus-lg me-1"></i>Agregar</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
