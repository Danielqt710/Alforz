@model IReadOnlyList<Alforz.Web.Models.Entities.Usuario>
@{
    ViewData["Title"] = "Usuarios";
    var idActual = ViewData["IdActual"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-people me-2"></i>Usuarios</h1>
    <span class="text-body-secondary">@Model.Count en total</span>
</div>

<div class="alf-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Último ingreso</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var esYo = u.Id == idActual;
                    <tr class="@(u.Activo ? "" : "opacity-50")">
                        <td class="fw-semibold">@u.NombreUsuario @if (esYo) { <span class="text-body-secondary small">(tú)</span> }</td>
                        <td>
                            @u.Correo
                            @if (!u.CorreoVerificado)
                            {
                                <i class="bi bi-exclamation-circle ms-1" title="Correo sin verificar"></i>
                            }
                        </td>
                        <td><span class="badge rounded-pill badge-rol badge-rol-@u.Rol.ToLowerInvariant()">@u.Rol</span></td>
                        <td>@(u.Activo ? "Activo" : "Desactivado")</td>
                        <td class="small">@(u.UltimoIngreso?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Nunca")</td>
                        <td class="text-end">
                            @if (!esYo)
                            {
                                <div class="d-inline-flex gap-2">
                                    <form asp-action="CambiarRol" method="post" class="d-inline-flex gap-1">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <select name="rol" class="form-select form-select-sm" aria-label="Rol de @u.NombreUsuario">
                                            @foreach (var rol in Roles.Todos)
                                            {
                                                <option value="@rol" selected="@(rol == u.Rol)">@rol</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-alf-primario" title="Guardar rol"><i class="bi bi-check-lg"></i></button>
                                    </form>
                                    <form asp-action="CambiarEstado" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button type="submit" class="btn btn-sm btn-alf-secundario">@(u.Activo ? "Desactivar" : "Activar")</button>
                                    </form>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
